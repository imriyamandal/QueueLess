# Application Environment
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-key-in-production
VERSION=1.0.0
DEMO_MODE=true
DEFAULT_TIMEZONE=Asia/Kolkata

# Database (SQLite for local zero-config testing; PostgreSQL for production deployment)
DATABASE_URL=sqlite:///./queueless.db
# DATABASE_URL=postgresql://queueless_user:queueless_secure_password@localhost:5432/queueless_db

# Frontend URLs & CORS Origins
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Firebase Cloud Messaging (Web Push Notifications)
# In dev/testing without credentials, FCM operates in simulated mode (DELIVERED_SIMULATED)
FCM_ENABLED=true
FIREBASE_PROJECT_ID=queueless-app
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or specify JSON directly:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Next.js Client-Side Firebase Web Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=queueless-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=queueless-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=queueless-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key

# Optional Real-SMS Provider Configuration (mock, msg91)
# Note: Web push is the primary alert channel. SMS is optional via MSG91.
SMS_PROVIDER=mock
SMS_ENABLED=true
SMS_SENDER_ID=QLESS

# MSG91 SMS Credentials (Required only when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
MSG91_SENDER_ID=QLESS
